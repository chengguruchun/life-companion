# Model (customer-selectable). Used only when not --dry-run and deepagents is installed.
# Examples: openai:gpt-4o-mini | anthropic:claude-sonnet-4-6 | deepseek:deepseek-chat
LIFE_COMPANION_MODEL=openai:gpt-4o-mini

# Provider keys — set the one matching your model string
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local data directory (goals + preference memory). Default: ./data
LIFE_COMPANION_DATA_DIR=./data

# Soft time-of-day prior locale (prompt hint only; NOT a hard tool whitelist)
LIFE_COMPANION_TZ=Asia/Shanghai
